{
  "name": "openvibe",
  "private": true,
  "version": "0.0.0",
  "description": "OpenVibe（灵典）—— vibe coding 的标准化工作台 monorepo",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --if-present dev",
    "build": "pnpm -r --if-present build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "seed:check": "tsx scripts/seed-check.ts",
    "seed:review": "tsx scripts/seed-review.ts",
    "golden:update": "tsx scripts/golden-update.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@openvibe/adapters": "workspace:*",
    "@openvibe/core": "workspace:*",
    "@openvibe/shared": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.0.0",
    "eslint-plugin-import-x": "^4.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
