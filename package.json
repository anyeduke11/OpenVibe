{
  "name": "openvibe",
  "private": true,
  "version": "0.0.0",
  "description": "OpenVibe（灵典）—— vibe coding 的标准化工作台 monorepo",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:each": "pnpm -r --if-present dev",
    "build": "pnpm -r --if-present build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "seed:check": "tsx scripts/seed-check.ts",
    "m9:collect": "tsx scripts/collect-m9-sources.ts",
    "m9:collect:github": "tsx scripts/collect-m9-github-sources.ts",
    "m9:fingerprint": "tsx scripts/m9-content-fingerprint.ts",
    "m9:links": "tsx scripts/check-m9-links.ts",
    "m9:phases": "tsx scripts/extract-m9-guide-phases.ts",
    "bundle:check": "pnpm --filter @openvibe/web build && tsx scripts/bundle-check.ts",
    "pkg:cli": "pnpm --filter @openvibe/web build && tsx scripts/build-cli.ts",
    "seed:review": "tsx scripts/seed-review.ts",
    "golden:update": "tsx scripts/golden-update.ts",
    "mutation:run": "tsx scripts/mutation-run.ts",
    "ownership:check": "tsx scripts/ownership-check.ts",
    "docs:check": "tsx scripts/docs-check.ts",
    "docs:refs": "tsx scripts/section-ref-audit.ts",
    "m9:grade-guard": "tsx scripts/m9-grade-guard.ts",
    "evidence": "scripts/failure-evidence.sh",
    "verify:matrix": "tsx scripts/verify-matrix.ts",
    "memory:check": "tsx scripts/export-agent-memory.ts --from ~/.minimax/agents/mavis/memory --check",
    "memory:verify": "tsx scripts/export-agent-memory.ts --from ~/.minimax/agents/mavis/memory --verify",
    "barrel:audit": "tsx scripts/barrel-audit.ts",
    "barrel:snapshot": "tsx scripts/barrel-snapshot.ts",
    "migrate:drill": "tsx scripts/migrate-drill.ts",
    "v023:preflight": "tsx scripts/v023-preflight.ts",
    "vibe:retro": "tsx scripts/vibe-retro-ingest.ts",
    "ci:preview": "tsx scripts/ci-preview.ts",
    "skills:sync": "tsx scripts/skills-sync.ts",
    "skills:check": "tsx scripts/skills-sync.ts --check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@openvibe/adapters": "workspace:*",
    "@openvibe/core": "workspace:*",
    "@openvibe/shared": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.0.0",
    "eslint-plugin-import-x": "^4.0.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
